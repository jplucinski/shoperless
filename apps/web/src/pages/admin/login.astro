---
import AdminLayout from "../../layouts/AdminLayout.astro";

const isDev = import.meta.env.DEV;
---
<AdminLayout title="Logowanie" bare>
  <div class="mx-auto max-w-md rounded-3xl border border-line bg-paper px-8 py-12">
    <h1 class="font-display m-0 text-4xl font-medium">Admin</h1>
    <p class="text-mute mt-2 mb-8">Wejście do zamówień, produktów i magazynu.</p>
    <p class="mb-8">
      <a href="/api/admin/furgonetka/start" class="shop-btn shop-btn-block no-underline">
        Zaloguj przez Furgonetkę
      </a>
    </p>
    {
      isDev && (
        <form method="post" action="/api/admin/login" class="flex flex-col gap-3">
          <label class="text-sm font-semibold">
            Hasło DEV
            <input class="shop-input mt-2" type="password" name="password" autocomplete="current-password" />
          </label>
          <button class="shop-btn" type="submit">
            Zaloguj hasłem
          </button>
        </form>
      )
    }
  </div>
</AdminLayout>
