---
import { formatPln, SEED_SHOP_ID } from "@liteshop/core";
import { furgonetkaOrderUrl } from "@liteshop/furgonetka";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { runAdminQuery } from "../../../lib/core.ts";

const id = Astro.params.id;
if (!id) {
  return new Response("Not found", { status: 404 });
}
const order = await runAdminQuery((services) => services.orders.get(SEED_SHOP_ID, id));
if (!order) {
  return Astro.redirect("/admin/orders");
}
---
<AdminLayout title={`Zamówienie ${order.id}`}>
  <p class="mb-6">
    <a href="/admin/orders" class="text-sm font-semibold text-mute no-underline hover:text-ink">
      ← Zamówienia
    </a>
  </p>
  <h1 class="font-display m-0 text-3xl font-medium">{order.id}</h1>
  <p class="text-mute mt-2">
    Płatność: {order.paymentStatus} · Wysyłka: {order.shippingStatus}
    {order.trackingNumber ? ` · ${order.trackingNumber}` : ""}
  </p>
  <p class="text-mute mt-2 text-sm">
    {order.shippingAddress.name} {order.shippingAddress.surname}<br />
    {order.shippingAddress.street}, {order.shippingAddress.postcode} {order.shippingAddress.city}<br />
    {order.shippingAddress.email}
  </p>
  <ul class="mt-8 mb-6 list-none rounded-2xl border border-line bg-paper p-0">
    {order.items.map((item) => (
      <li class="flex justify-between gap-4 border-b border-line px-5 py-4 last:border-b-0">
        <span>
          {item.sku} × {item.quantity}
        </span>
        <span class="font-semibold">{formatPln(item.unitPrice)}</span>
      </li>
    ))}
  </ul>
  <p class="mb-8 text-xl font-semibold">Suma: {formatPln(order.total)}</p>
  <a class="shop-btn no-underline" href={furgonetkaOrderUrl(order.id)}>
    Otwórz w Furgonetce
  </a>
</AdminLayout>
