---
import { formatPln, SEED_SHOP_ID } from "@liteshop/core";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { runAdminQuery } from "../../../lib/core.ts";

const listed = await runAdminQuery((services) => services.orders.list(SEED_SHOP_ID));
---
<AdminLayout title="Zamówienia">
  <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-moss">Admin</p>
  <h1 class="font-display m-0 mb-8 text-4xl font-medium">Zamówienia</h1>
  {
    !listed ? (
      <p class="rounded-2xl border border-line bg-paper px-5 py-4 text-mute">
        Dynamo / SST niedostępne.
      </p>
    ) : listed.length === 0 ? (
      <p class="text-mute">Brak zamówień.</p>
    ) : (
      <div class="overflow-hidden rounded-2xl border border-line bg-paper">
        <table class="shop-table">
          <thead>
            <tr>
              <th>id</th>
              <th>płatność</th>
              <th>wysyłka</th>
              <th>suma</th>
            </tr>
          </thead>
          <tbody>
            {listed.map((order) => (
              <tr>
                <td>
                  <a class="font-semibold text-ink no-underline hover:text-moss" href={`/admin/orders/${order.id}`}>
                    {order.id}
                  </a>
                </td>
                <td>{order.paymentStatus}</td>
                <td>{order.shippingStatus}</td>
                <td>{formatPln(order.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
