---
import { formatPln, SEED_SHOP_ID } from "@liteshop/core";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { runAdminQuery } from "../../../lib/core.ts";

const listed = await runAdminQuery((services) => services.products.list(SEED_SHOP_ID));
---
<AdminLayout title="Produkty">
  <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-moss">Admin</p>
  <h1 class="font-display m-0 mb-8 text-4xl font-medium">Produkty</h1>
  {
    !listed ? (
      <p class="mb-8 rounded-2xl border border-line bg-paper px-5 py-4 text-mute">
        Dynamo / SST niedostępne — formularz nie zapisze.
      </p>
    ) : listed.length === 0 ? (
      <p class="text-mute mb-8">Brak produktów.</p>
    ) : (
      <div class="mb-10 overflow-hidden rounded-2xl border border-line bg-paper">
        <table class="shop-table">
          <thead>
            <tr>
              <th>SKU</th>
              <th>nazwa</th>
              <th>cena</th>
              <th>status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {listed.map((product) => (
              <tr>
                <td>{product.sku}</td>
                <td>{product.name}</td>
                <td>{formatPln(product.price)}</td>
                <td>{product.status}</td>
                <td>
                  <button
                    type="button"
                    class="shop-btn shop-btn-ghost"
                    data-sku={product.sku}
                    data-status={product.status === "active" ? "inactive" : "active"}
                  >
                    {product.status === "active" ? "Wyłącz" : "Włącz"}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <form id="product-form" class="grid max-w-lg gap-3 rounded-2xl border border-line bg-paper p-6">
    <h2 class="font-display m-0 text-2xl font-medium">Nowy produkt</h2>
    <input class="shop-input" name="sku" placeholder="SKU" required />
    <input class="shop-input" name="slug" placeholder="slug" required />
    <input class="shop-input" name="name" placeholder="Nazwa" required />
    <textarea class="shop-input min-h-24" name="description" placeholder="Opis"></textarea>
    <input class="shop-input" name="priceZloty" type="number" min="0.01" step="0.01" placeholder="Cena PLN" required />
    <button class="shop-btn" type="submit">Dodaj</button>
  </form>
  <script is:inline>
    const form = document.getElementById("product-form");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      await fetch("/api/admin/products", {
        method: "POST",
        headers: { "content-type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({
          sku: data.get("sku"),
          slug: data.get("slug"),
          name: data.get("name"),
          description: data.get("description") ?? "",
          priceZloty: Number(data.get("priceZloty")),
        }),
      });
      location.reload();
    });
    for (const button of document.querySelectorAll("[data-sku][data-status]")) {
      button.addEventListener("click", async () => {
        await fetch("/api/admin/products", {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({
            sku: button.getAttribute("data-sku"),
            status: button.getAttribute("data-status"),
          }),
        });
        location.reload();
      });
    }
  </script>
</AdminLayout>
