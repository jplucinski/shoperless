---
import ShopLayout from "../layouts/ShopLayout.astro";
---
<ShopLayout title="Kontakt" bleed>
  <section class="contact">
    <header class="contact-lead reveal">
      <p class="home-kicker">Pracownia</p>
      <h1>Napisz.</h1>
      <p>Pytania o zamówienie, reklamację albo dane osobowe.</p>
    </header>
    <div class="contact-grid">
      <article class="contact-mail reveal">
        <div class="pola-shell">
          <div class="contact-card contact-card-ink">
            <span>01</span>
            <div>
              <p class="contact-label">Skrzynka</p>
              <strong>LiteShop</strong>
              <p>Jedna pracownia, jedna skrzynka. Odpowiadamy w dni robocze.</p>
              <a class="contact-address" href="mailto:kontakt@localhost">kontakt@localhost</a>
              <a class="shop-btn" href="mailto:kontakt@localhost">
                Napisz
                <span class="btn-orb" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </article>
      <article class="reveal">
        <div class="pola-shell">
          <div class="contact-card contact-card-hours">
            <span>02</span>
            <div>
              <strong>Dni robocze</strong>
              <p>Od poniedziałku do piątku. Weekend zostaje na obraz.</p>
            </div>
          </div>
        </div>
      </article>
      <article class="reveal">
        <div class="pola-shell">
          <div class="contact-card contact-card-topics">
            <span>03</span>
            <div>
              <strong>Trzy sprawy</strong>
              <ul>
                <li>Zamówienie</li>
                <li>Reklamacja</li>
                <li>Dane osobowe</li>
              </ul>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>
</ShopLayout>
