---
import ShopLayout from "../layouts/ShopLayout.astro";
---
<ShopLayout title="Kontakt">
  <article class="max-w-2xl">
    <h1 class="font-display m-0 text-4xl font-medium">Kontakt</h1>
    <p class="text-mute mt-3 mb-8">Pytania o zamówienie, reklamację albo dane osobowe.</p>
    <div class="rounded-3xl border border-line bg-paper px-6 py-6 leading-relaxed">
      <p class="m-0"><strong>LiteShop</strong></p>
      <p class="text-mute mt-2 mb-0">e-mail: kontakt@localhost</p>
      <p class="text-mute mt-2 mb-0">Odpowiadamy w dni robocze.</p>
    </div>
  </article>
</ShopLayout>
