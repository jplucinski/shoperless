---
import {
  formatPln,
  ProductInactiveError,
  ProductNotFoundError,
  SEED_SHOP_ID,
  type Product,
} from "@liteshop/core";
import { CartButton } from "../../islands/CartButton.tsx";
import ShopLayout from "../../layouts/ShopLayout.astro";
import { createServices } from "../../lib/core.ts";
import { DEV_PREVIEW_PRODUCT } from "../../lib/dev-preview-product.ts";

const slug = Astro.params.slug;
if (!slug) {
  return new Response("Not found", { status: 404 });
}
let product: Product;
try {
  const { products } = createServices();
  product = await products.getActiveBySlug(SEED_SHOP_ID, slug);
} catch (error) {
  if (error instanceof ProductNotFoundError || error instanceof ProductInactiveError) {
    return new Response("Not found", { status: 404 });
  }
  if (import.meta.env.DEV && slug === DEV_PREVIEW_PRODUCT.slug) {
    product = DEV_PREVIEW_PRODUCT;
  } else {
    throw error;
  }
}
---
<ShopLayout title={product.name}>
  <p class="mb-6">
    <a href="/" class="text-sm font-semibold text-mute no-underline hover:text-ink">← Sklep</a>
  </p>
  <article class="grid gap-10 md:grid-cols-2">
    <div class="flex min-h-72 items-end rounded-3xl bg-[linear-gradient(160deg,#d7e0d4,#c5b7a5)] px-6 py-5">
      <span class="font-display text-paper text-5xl">{product.name.slice(0, 1)}</span>
    </div>
    <div>
      <h1 class="font-display m-0 text-4xl font-medium">{product.name}</h1>
      <p class="mt-3 text-2xl font-semibold">{formatPln(product.price)}</p>
      <p class="text-mute mt-4 max-w-md leading-relaxed">{product.description}</p>
      <div class="mt-8">
        <CartButton client:load sku={product.sku} />
      </div>
    </div>
  </article>
</ShopLayout>
