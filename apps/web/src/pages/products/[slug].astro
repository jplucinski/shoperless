---
import {
  formatPln,
  ProductInactiveError,
  ProductNotFoundError,
  SEED_SHOP_ID,
  type Product,
} from "@liteshop/core";
import { CartButton } from "../../islands/CartButton.tsx";
import ShopLayout from "../../layouts/ShopLayout.astro";
import { createServices } from "../../lib/core.ts";
import { DEV_PREVIEW_PRODUCTS } from "../../lib/dev-preview-product.ts";
import { artistFor, descriptionFor, photosFor, titleFor } from "../../lib/product-photos.ts";

const slug = Astro.params.slug;
if (!slug) {
  return new Response("Not found", { status: 404 });
}
let product: Product;
try {
  const { products } = createServices();
  product = await products.getActiveBySlug(SEED_SHOP_ID, slug);
} catch (error) {
  if (error instanceof ProductNotFoundError || error instanceof ProductInactiveError) {
    return new Response("Not found", { status: 404 });
  }
  const preview = import.meta.env.DEV
    ? DEV_PREVIEW_PRODUCTS.find((item) => item.slug === slug)
    : undefined;
  if (preview) {
    product = preview;
  } else {
    throw error;
  }
}
const photos = photosFor(product);
const title = titleFor(product);
const artist = artistFor(product);
const description = descriptionFor(product);
const more = photos.slice(1);
---
<ShopLayout title={title} bleed>
  <article class="pdp">
    <div class="pdp-stage">
      <div class="pola-shell reveal">
        <div class="pdp-visual work-frame">
          <img src={photos[0]} alt={title} class="work-in" />
        </div>
      </div>
      {
        more.length > 0 && (
          <div class="pdp-film">
            {more.map((src) => (
              <div class="pola-shell reveal">
                <div class="pdp-thumb work-frame">
                  <img src={src} alt="" />
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
    <div class="pdp-copy reveal">
      <a href="/prace" class="pdp-back">Wszystkie prace</a>
      {artist && <p class="pdp-kicker">{artist}</p>}
      <h1 class="pdp-title">{title}</h1>
      <p class="pdp-price">{formatPln(product.price)}</p>
      {description && <p class="pdp-note">{description}</p>}
      <CartButton client:load sku={product.sku} />
    </div>
  </article>
</ShopLayout>
