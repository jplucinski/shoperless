---
import {
  formatPln,
  ProductInactiveError,
  ProductNotFoundError,
  SEED_SHOP_ID,
  type Product,
} from "@liteshop/core";
import ShopLayout from "../../layouts/ShopLayout.astro";
import { createServices } from "../../lib/core.ts";
import { DEV_PREVIEW_PRODUCTS } from "../../lib/dev-preview-product.ts";
import {
  descriptionFor,
  descriptionParagraphs,
  pdpDetails,
  photosFor,
  titleFor,
} from "../../lib/product-photos.ts";
import {
  absoluteAssetUrl,
  altTextFor,
  productJsonLd,
  seoDescriptionFor,
  seoTitleFor,
} from "../../lib/product-seo.ts";

const slug = Astro.params.slug;
if (!slug) {
  return new Response("Not found", { status: 404 });
}
let product: Product;
try {
  const { products } = createServices();
  product = await products.getActiveBySlug(SEED_SHOP_ID, slug);
} catch (error) {
  if (error instanceof ProductNotFoundError || error instanceof ProductInactiveError) {
    return new Response("Not found", { status: 404 });
  }
  const preview = import.meta.env.DEV
    ? DEV_PREVIEW_PRODUCTS.find((item) => item.slug === slug)
    : undefined;
  if (preview) {
    product = preview;
  } else {
    throw error;
  }
}
const photos = photosFor(product);
const title = titleFor(product);
const description = descriptionFor(product);
const paragraphs = descriptionParagraphs(description);
const details = pdpDetails(product);
const encodedSku = encodeURIComponent(product.sku);
const seoTitle = seoTitleFor(product);
const seoDescription = seoDescriptionFor(product);
const alt = altTextFor(product);
const origin = Astro.url.origin;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const jsonLd = productJsonLd({
  product,
  pageUrl,
  images: photos.map((src) => absoluteAssetUrl(origin, src)),
});
---
<ShopLayout
  title={seoTitle}
  description={seoDescription || undefined}
  image={photos[0]}
  jsonLd={jsonLd}
  bleed
>
  <article class="pdp">
    <div class="pdp-stage">
      {
        photos.length > 0 && (
          <div class="pola-shell pdp-stage-shell">
            <div class="pdp-visual work-frame">
              <img
                id="pdp-stage-img"
                src={photos[0]}
                alt={photos.length > 1 ? `${alt} — zdjęcie 1` : alt}
                class="work-in"
              />
            </div>
          </div>
        )
      }
      {
        photos.length > 1 && (
          <div class="pdp-film" role="group" aria-label="Galeria">
            {photos.map((src, index) => (
              <button
                type="button"
                class:list={["pdp-film-btn", index === 0 && "is-active"]}
                data-pdp-src={src}
                data-pdp-index={index + 1}
                aria-pressed={index === 0 ? "true" : "false"}
                aria-label={`Zdjęcie ${index + 1}`}
              >
                <span class="pola-shell pdp-film-frame">
                  <span class="pdp-thumb work-frame">
                    <img src={src} alt="" loading="lazy" decoding="async" />
                  </span>
                </span>
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="pdp-copy reveal">
      <a href="/prace" class="pdp-back">Wszystkie prace</a>
      <h1 class="pdp-title">{title}</h1>
      <p class="pdp-price">{formatPln(product.price)}</p>
      {
        paragraphs.length > 0 && (
          <div class="pdp-description">
            {paragraphs.map((part) => (
              <p class="pdp-note">{part}</p>
            ))}
          </div>
        )
      }
      {
        details.length > 0 && (
          <dl class="pdp-details">
            {details.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        )
      }
      <a href={`/cart?add=${encodedSku}`} class="shop-btn no-underline">
        Do koszyka
        <span class="btn-orb" aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
  {
    photos.length > 1 && (
      <script is:inline>
        (function () {
          var stage = document.getElementById("pdp-stage-img");
          var buttons = document.querySelectorAll("[data-pdp-src]");
          if (!stage || !buttons.length) return;
          var title = stage.getAttribute("alt") || "";
          var baseTitle = title.replace(/ — zdjęcie \d+$/, "");
          buttons.forEach(function (btn) {
            btn.addEventListener("click", function () {
              var src = btn.getAttribute("data-pdp-src");
              var index = btn.getAttribute("data-pdp-index");
              if (!src || !index) return;
              stage.setAttribute("src", src);
              stage.setAttribute("alt", baseTitle + " — zdjęcie " + index);
              buttons.forEach(function (other) {
                var active = other === btn;
                other.classList.toggle("is-active", active);
                other.setAttribute("aria-pressed", active ? "true" : "false");
              });
            });
          });
        })();
      </script>
    )
  }
</ShopLayout>
