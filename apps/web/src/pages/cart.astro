---
import { CartView } from "../islands/CartView.tsx";
import ShopLayout from "../layouts/ShopLayout.astro";
import { koszykCheckoutScriptSrc, koszykCheckoutUuid } from "../lib/koszyk.ts";

const checkoutUuid = koszykCheckoutUuid();
const checkoutScript = koszykCheckoutScriptSrc(import.meta.env.KOSZYK_ENV);
---
<ShopLayout title="Koszyk" wide>
  <Fragment slot="head">
    {checkoutUuid ? <script src={checkoutScript} defer /> : null}
  </Fragment>
  <CartView client:load checkoutUuid={checkoutUuid} />
</ShopLayout>
