---
import { formatPln, SEED_SHOP_ID } from "@liteshop/core";
import { createServices } from "../lib/core.ts";

const { products } = createServices();
const listed = await products.listActive(SEED_SHOP_ID);
---
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <title>LiteShop</title>
  </head>
  <body>
    <h1>LiteShop</h1>
    <p><a href="/cart">Koszyk</a></p>
    <ul>
      {listed.map((product) => (
        <li>
          <a href={`/products/${product.slug}`}>{product.name}</a>
          {" "}
          {formatPln(product.price)}
        </li>
      ))}
    </ul>
  </body>
</html>
