---
import { formatPln, SEED_SHOP_ID, type Product } from "@liteshop/core";
import ShopLayout from "../layouts/ShopLayout.astro";
import { DEV_PREVIEW_PRODUCTS } from "../lib/dev-preview-product.ts";
import { artistFor, photosFor, titleFor } from "../lib/product-photos.ts";
import { createServices } from "../lib/core.ts";

let listed: Product[] = [];
let catalogError = false;
try {
  const { products } = createServices();
  listed = await products.listActive(SEED_SHOP_ID);
} catch {
  catalogError = true;
  if (import.meta.env.DEV) {
    listed = DEV_PREVIEW_PRODUCTS;
  }
}

const featured = listed[0];
const rest = listed.slice(1);
---
<ShopLayout
  title="LiteShop — obraz i rysunek"
  description="Każda praca jest jedna. Obraz albo rysunek, bez serii i bez dodruku."
  bleed
>
  {
    catalogError ? (
      <p class="border-line bg-paper text-ink mx-5 border px-5 py-4 md:mx-10">
        Katalog chwilowo niedostępny.
      </p>
    ) : null
  }
  {
    listed.length === 0 && !catalogError ? (
      <p class="border-line bg-paper text-ink mx-5 border px-5 py-4 md:mx-10">
        Brak aktywnych prac.
      </p>
    ) : listed.length > 0 ? (
      <section class="home">
        <div class="home-lead reveal">
          <p class="home-kicker">Studio</p>
          <h1 class="home-title">Obraz i rysunek.</h1>
          <p class="home-lede">Każda praca jest jedna. Wybierz ją w katalogu albo wejdź od razu w najnowszą.</p>
          <a href="/prace" class="shop-btn">
            Katalog
            <span class="btn-orb" aria-hidden="true">↗</span>
          </a>
        </div>
        {featured && (
          <div class="home-feature reveal">
            <a href={`/products/${featured.slug}`} class="home-shot" aria-label={titleFor(featured)}>
              <div class="pola-shell">
                <div class="home-visual work-frame">
                  <img src={photosFor(featured)[0]} alt="" />
                </div>
              </div>
            </a>
            <div class="pola-shell">
              <div class="home-plate">
                <a href={`/products/${featured.slug}`} class="home-caption">
                  <span>{artistFor(featured)}</span>
                  <strong>{titleFor(featured)}</strong>
                  <em>{formatPln(featured.price)}</em>
                </a>
                {rest.length > 0 && (
                  <ul class="home-index">
                    {rest.map((product) => (
                      <li>
                        <a href={`/products/${product.slug}`}>
                          <img src={photosFor(product)[0]} alt="" />
                          <span>
                            <small>{artistFor(product)}</small>
                            {titleFor(product)}
                          </span>
                          <em>{formatPln(product.price)}</em>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        )}
        <section class="home-atelier" aria-labelledby="atelier-title">
          <div class="home-atelier-copy reveal">
            <p class="home-kicker">Pracownia</p>
            <h2 id="atelier-title">Jedna praca. Jedna osoba.</h2>
            <p>Po sprzedaży schodzi z katalogu. Zostaje tylko u Ciebie.</p>
            <a href="/kontakt" class="shop-btn">
              Napisz
              <span class="btn-orb" aria-hidden="true">↗</span>
            </a>
          </div>
          <ol class="home-facts">
            <li class="reveal">
              <div class="pola-shell">
                <div class="home-fact">
                  <span>01</span>
                  <div>
                    <strong>Egzemplarz</strong>
                    <p>Obraz albo rysunek. Bez serii i bez dodruku.</p>
                  </div>
                </div>
              </div>
            </li>
            <li class="reveal">
              <div class="pola-shell">
                <div class="home-fact">
                  <span>02</span>
                  <div>
                    <strong>Medium</strong>
                    <p>Płótno, papier, pigment. To, co widać, jest całością.</p>
                  </div>
                </div>
              </div>
            </li>
            <li class="reveal">
              <div class="pola-shell">
                <div class="home-fact">
                  <span>03</span>
                  <div>
                    <strong>Odbiór</strong>
                    <p>Osobiście albo paczką. Szczegóły po zakupie.</p>
                  </div>
                </div>
              </div>
            </li>
          </ol>
        </section>
      </section>
    ) : null
  }
</ShopLayout>
