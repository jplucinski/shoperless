---
import "../styles/global.css";

interface Props {
  title: string;
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: "/admin", label: "Dashboard", active: path === "/admin" },
  { href: "/admin/orders", label: "Zamówienia", active: path.startsWith("/admin/orders") },
  { href: "/admin/products", label: "Produkty", active: path.startsWith("/admin/products") },
  { href: "/admin/inventory", label: "Magazyn", active: path.startsWith("/admin/inventory") },
];
---
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,650&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line bg-paper/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-none items-center justify-between gap-4 px-6 py-4 xl:px-10">
        <a href={bare ? "/admin/login" : "/admin"} class="font-display text-xl tracking-tight text-ink no-underline">
          LiteShop
        </a>
        {
          bare ? (
            <a href="/" class="text-sm font-semibold text-mute no-underline hover:text-ink">
              Sklep
            </a>
          ) : (
            <nav class="flex flex-wrap items-center gap-5 text-sm font-semibold">
              {links.map((link) => (
                <a
                  href={link.href}
                  class:list={["no-underline", link.active ? "text-moss" : "text-mute hover:text-ink"]}
                >
                  {link.label}
                </a>
              ))}
              <a href="/" class="text-mute no-underline hover:text-ink">
                Sklep
              </a>
            </nav>
          )
        }
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl self-center flex-1 px-6 py-8 xl:px-10">
      <slot />
    </main>
    <footer class="mt-auto border-t border-line">
      <div class="text-mute mx-auto flex w-full px-6 py-5 text-sm xl:px-10">
        <span>Admin</span>
      </div>
    </footer>
  </body>
</html>
