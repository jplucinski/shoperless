---
import "../styles/global.css";

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
const path = Astro.url.pathname;
---
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,650&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line bg-paper/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-none items-center justify-between gap-4 px-6 py-4 xl:px-10">
        <a href="/" class="font-display text-xl tracking-tight text-ink no-underline">LiteShop</a>
        <nav class="flex items-center gap-5 text-sm font-semibold">
          <a
            href="/"
            class:list={["no-underline", path === "/" ? "text-moss" : "text-mute hover:text-ink"]}
          >
            Sklep
          </a>
          <a
            href="/cart"
            class:list={[
              "no-underline",
              path === "/cart" ? "text-moss" : "text-mute hover:text-ink",
            ]}
          >
            Koszyk
          </a>
        </nav>
      </div>
    </header>
    <main
      class:list={[
        "mx-auto w-full self-center flex-1 px-6 py-8 xl:px-10",
        wide ? "flex max-w-4xl flex-col justify-center" : "max-w-5xl",
      ]}
    >
      <slot />
    </main>
    <footer class="mt-auto border-t border-line">
      <div
        class="text-mute mx-auto flex w-full items-center justify-between gap-3 px-6 py-5 text-sm xl:px-10"
      >
        <span>LiteShop</span>
        <nav class="flex flex-wrap gap-4 font-semibold">
          <a href="/regulamin" class="text-mute no-underline hover:text-ink">Regulamin</a>
          <a href="/rodo" class="text-mute no-underline hover:text-ink">RODO</a>
          <a href="/kontakt" class="text-mute no-underline hover:text-ink">Kontakt</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
